{
  "name": "@vistyy/pi-workgraph",
  "version": "0.1.0",
  "type": "module",
  "description": "Conversational, durable local work coordination for Pi.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "bin": {
    "pi-workgraph": "./bin/pi-workgraph.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "orchestration",
    "worktree"
  ],
  "files": [
    "bin",
    "extensions",
    "src",
    "skills",
    "README.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "quality": "biome check --error-on-warnings && node --import tsx scripts/check-assertions.ts",
    "check": "pnpm typecheck && pnpm quality && pnpm test",
    "smoke:herdr": "node --import tsx scripts/herdr-smoke.ts",
    "smoke:coordinator": "node --import tsx scripts/coordinator-smoke.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/coordinator.ts",
      "./extensions/worker.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
