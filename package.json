{
  "name": "@vistyy/pi-workgraph",
  "version": "0.1.0",
  "type": "module",
  "description": "Conversational, durable local work coordination for Pi.",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "bin": {
    "pi-workgraph": "./bin/pi-workgraph.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "orchestration",
    "worktree"
  ],
  "files": [
    "bin",
    "extensions",
    "src",
    "skills",
    "README.md",
    "DESIGN.md",
    "VERIFICATION.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm exec effect-tsgo patch --oxlint --no-typescript",
    "quality": "pnpm exec biome check --error-on-warnings .; biome_status=$?; pnpm exec oxlint --config oxlint.config.ts .; oxlint_status=$?; test $biome_status -eq 0 -a $oxlint_status -eq 0",
    "check": "pnpm quality && pnpm test",
    "smoke:herdr": "node --import tsx scripts/herdr-smoke.ts",
    "smoke:coordinator": "node --import tsx scripts/coordinator-smoke.ts",
    "smoke:natural": "node --import tsx scripts/natural-coordinator-smoke.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/coordinator.ts",
      "./extensions/worker.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@effect/tsgo": "0.41.0",
    "@syzom/typescript-quality": "0.2.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "^1.0.0",
    "typescript": "7.0.2"
  }
}
