{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@syzom/typescript-quality/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true
  },
  "include": [
    "extensions/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "bin/**/*.mjs",
    "oxlint.config.ts"
  ]
}
